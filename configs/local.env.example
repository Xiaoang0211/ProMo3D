# Optional. Copy to configs/local.env and set only the values you need.
# Values already supplied in the shell can also be used without this file.

# DATASETS_DIR=/path/to/datasets
# TOKEN_ROOT=/path/to/external/ssd/promo3d_tokens
# OUTPUT_ROOT=/path/to/promo3d/outputs

# Set separate interpreters when the backbones use different environments.
# PI3_PYTHON_BIN=/path/to/envs/pi3/bin/python
# VGGT_PYTHON_BIN=/path/to/envs/vggt/bin/python
# DA3_PYTHON_BIN=/path/to/envs/depthanything3/bin/python
# MAPANYTHING_PYTHON_BIN=/path/to/envs/mapanything/bin/python
# DUST3R_PYTHON_BIN=/path/to/envs/dust3r/bin/python
# SAM2_PYTHON_BIN=/path/to/envs/pi3/bin/python
# ANALYSIS_PYTHON_BIN=/path/to/envs/pi3/bin/python

# Defaults point to checkpoints inside models/ in this workspace.
# PI3X_CHECKPOINT=/path/to/model_pi3x.safetensors
# PI3_CHECKPOINT=/path/to/model_pi3.safetensors
# VGGT_CHECKPOINT=/path/to/model.pt
# DA3_MODEL_DIR=/path/to/DA3-giant-1.1
# MAPANYTHING_CHECKPOINT=/path/to/mapanything/checkpoint_directory
# DUST3R_WEIGHTS=/path/to/DUSt3R_ViTLarge_BaseDecoder_512_dpt.pth
# SAM2_REPO_ROOT=/path/to/sam2
# SAM2_CHECKPOINT=/path/to/sam2.1_hiera_large.pt

# Runtime comparisons additionally require their released repositories/assets.
# GEOMOTION_ROOT=/path/to/GeoMotion
# GEOMOTION_RUNTIME_ROOT=/path/to/geomotion_runtime_assets
# FLOWSAM_ROOT=/path/to/flowsam
# FLOWSAM_RUNTIME_ROOT=/path/to/flowsam_runtime_assets
# SEGANYMO_ROOT=/path/to/SegAnyMo
# SEGANYMO_RUNTIME_ROOT=/path/to/seganymo_runtime_assets
# GEOMOTION_PYTHON_BIN=/path/to/compatible/env/bin/python
# FLOWSAM_PYTHON_BIN=/path/to/compatible/env/bin/python
# SEGANYMO_PYTHON_BIN=/path/to/compatible/env/bin/python
