diff --git a/src/depth_anything_3/model/utils/attention_recorder.py b/src/depth_anything_3/model/utils/attention_recorder.py
new file mode 100644
index 0000000..25df3bc
--- /dev/null
+++ b/src/depth_anything_3/model/utils/attention_recorder.py
@@ -0,0 +1,74 @@
+from __future__ import annotations
+
+from typing import Dict, Optional
+import torch
+
+
+class VisionAttentionRecorder:
+    """
+    Helper that toggles attention recording for DinoV2 vision transformers and
+    retrieves the stored attention maps after a forward pass.
+    """
+
+    def __init__(self, backbone) -> None:
+        self.enabled = False
+        self.vit = getattr(backbone, "pretrained", None)
+        if self.vit is None or not hasattr(self.vit, "blocks"):
+            self.blocks = []
+            self.patch_size = None
+            self.patch_token_start = None
+            self.batch_size = None
+            self.seq_len = None
+            self.block_modes = {}
+            return
+        self.blocks = list(self.vit.blocks)
+        self.patch_size = getattr(self.vit, "patch_size", 14)
+        patch_start = getattr(self.vit, "patch_start_idx", 1)
+        num_register = getattr(self.vit, "num_register_tokens", 0)
+        self.patch_token_start = patch_start + num_register
+        self.batch_size = None
+        self.seq_len = None
+        self.block_modes: Dict[int, str] = {}
+        alt_start = getattr(self.vit, "alt_start", -1)
+        for idx, _ in enumerate(self.blocks):
+            is_global = alt_start != -1 and idx >= alt_start and idx % 2 == 1
+            self.block_modes[idx] = "global" if is_global else "local"
+
+    def is_available(self) -> bool:
+        return bool(self.blocks) and self.patch_size is not None
+
+    def set_enabled(self, enabled: bool) -> None:
+        if not self.is_available():
+            return
+        self.enabled = enabled
+        for block in self.blocks:
+            attn = getattr(block, "attn", None)
+            if hasattr(attn, "set_record_attention"):
+                attn.set_record_attention(enabled)
+            if not enabled and hasattr(attn, "pop_last_attention"):
+                attn.pop_last_attention()
+
+    def update_sequence_info(self, batch_size: int, seq_len: int) -> None:
+        self.batch_size = batch_size
+        self.seq_len = seq_len
+
+    def collect(self) -> Optional[Dict]:
+        if not self.enabled or not self.is_available():
+            return None
+        attn_maps: Dict[int, torch.Tensor] = {}
+        for idx, block in enumerate(self.blocks):
+            attn = getattr(block, "attn", None)
+            if hasattr(attn, "pop_last_attention"):
+                recorded = attn.pop_last_attention()
+                if recorded is not None:
+                    attn_maps[idx] = recorded
+        if not attn_maps:
+            return None
+        return {
+            "maps": attn_maps,
+            "patch_size": self.patch_size,
+            "patch_token_start": self.patch_token_start,
+            "batch_size": self.batch_size,
+            "sequence_length": self.seq_len,
+            "block_modes": self.block_modes,
+        }
